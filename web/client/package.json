{
  "name": "electric-beats-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React keypad readout for electric_beats",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --jsx=automatic --format=esm --outfile=dist/bundle.js --define:process.env.NODE_ENV='\"production\"'",
    "watch": "esbuild src/main.jsx --bundle --jsx=automatic --format=esm --outfile=dist/bundle.js --define:process.env.NODE_ENV='\"development\"' --sourcemap --watch"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
